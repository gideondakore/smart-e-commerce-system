<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.amalitech.smartecommerce.controllers.AdminDashboardController"
            style="-fx-background-color: #f3f4f6;">
    
    <!-- Top Navigation Bar -->
    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20;">
                <Label text="🛒" style="-fx-font-size: 24px;"/>
                <Label text="Admin Dashboard" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="welcomeLabel" text="Welcome, Admin" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                <Button text="Logout" onAction="#handleLogout" 
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
            </HBox>
            
            <!-- Stats Cards -->
            <HBox spacing="20" style="-fx-padding: 0 20 20 20;">
                <VBox spacing="5" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-padding: 20; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                    <Label text="Total Products" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-opacity: 0.9;"/>
                    <Label fx:id="statsProducts" text="0" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="5" style="-fx-background-color: linear-gradient(to right, #f093fb, #f5576c); -fx-padding: 20; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                    <Label text="Total Users" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-opacity: 0.9;"/>
                    <Label fx:id="statsUsers" text="0" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="5" style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe); -fx-padding: 20; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                    <Label text="Categories" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-opacity: 0.9;"/>
                    <Label fx:id="statsCategories" text="0" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>
    
    <!-- Main Content -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            <!-- Search and Actions -->
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;">
                <TextField fx:id="searchField" promptText="Search products..." HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10;"/>
                <Button text="Search" onAction="#handleSearch" 
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 6; -fx-cursor: hand;"/>
                <Button text="+ Add Product" onAction="#handleAddProduct" 
                        style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
            
            <!-- Products Table -->
            <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;">
                <Label text="Product Management" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-padding: 0 0 10 0;"/>
                <TableView fx:id="productTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colName" text="Product Name" prefWidth="300"/>
                        <TableColumn fx:id="colPrice" text="Price" prefWidth="120"/>
                        <TableColumn fx:id="colStock" text="Stock" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
    
    <!-- Bottom Actions -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-background-color: white; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, -2);">
            <Button text="Edit Selected" onAction="#handleEditProduct" 
                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button text="Delete Selected" onAction="#handleDeleteProduct" 
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button text="Manage Users" onAction="#handleManageUsers" 
                    style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button text="Manage Categories" onAction="#handleManageCategories" 
                    style="-fx-background-color: #ec4899; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
</BorderPane>
