<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.amalitech.smartecommerce.controllers.CustomerDashboardController"
            style="-fx-background-color: #f3f4f6;">
    
    <!-- Top Navigation Bar -->
    <top>
        <VBox style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20;">
                <Label text="Shop" style="-fx-font-size: 24px;"/>
                <Label text="Shop Now" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="welcomeLabel" text="Welcome, Customer" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                <Button text="My Orders" onAction="#handleViewOrders" 
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 6;"/>
                <Button text="Logout" onAction="#handleLogout" 
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 6;"/>
            </HBox>
            
            <!-- Search Bar -->
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 0 20 20 20;">
                <TextField fx:id="searchField" promptText="Search for products..." HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14px;"/>
                <Button text="Search" onAction="#handleSearch" 
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-padding: 12 30; -fx-background-radius: 8; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- Main Content -->
    <center>
        <HBox spacing="20" style="-fx-padding: 20;">
            <!-- Products Section -->
            <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
                <Label text="Available Products" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                <TableView fx:id="productTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colName" text="Product Name" prefWidth="250"/>
                        <TableColumn fx:id="colPrice" text="Price" prefWidth="100"/>
                        <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
                    </columns>
                </TableView>
                <Button text="Add to Cart" onAction="#handleAddToCart" maxWidth="Infinity"
                        style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            </VBox>
            
            <!-- Shopping Cart Section -->
            <VBox spacing="15" prefWidth="350" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
                <Label text="Shopping Cart" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                
                <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colCartName" text="Item" prefWidth="150"/>
                        <TableColumn fx:id="colCartQty" text="Qty" prefWidth="60"/>
                        <TableColumn fx:id="colCartPrice" text="Price" prefWidth="100"/>
                    </columns>
                </TableView>
                
                <Separator/>
                
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Label text="Total:" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                    <Label fx:id="totalLabel" text="$0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                </HBox>
                
                <Button text="Remove Selected" onAction="#handleRemoveFromCart" maxWidth="Infinity"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 8;"/>
                
                <Button text="Checkout" onAction="#handleCheckout" maxWidth="Infinity"
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-padding: 14; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
