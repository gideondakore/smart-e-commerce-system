<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.amalitech.smartecommerce.controllers.SignupController"
           style="-fx-background-color: linear-gradient(to bottom right, #667eea 0%, #764ba2 100%);">
    
    <VBox alignment="CENTER" spacing="20" maxWidth="550" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5);">
        <padding>
            <Insets top="40" right="50" bottom="40" left="50"/>
        </padding>
        
        <VBox alignment="CENTER" spacing="10">
            <Label text="🛒" style="-fx-font-size: 48px;"/>
            <Label text="Create Account" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
            <Label text="Join Smart E-Commerce today" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
            <Label text="Password must be 8+ chars with uppercase, lowercase, digit, and special character" 
                   style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-font-style: italic;" wrapText="true" maxWidth="450"/>
        </VBox>
        
        <Label fx:id="errorLabel" text="Error message" 
               style="-fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-background-color: #fee2e2; -fx-padding: 8 12; -fx-background-radius: 5;"
               wrapText="true" maxWidth="Infinity" visible="false"/>
        
        <VBox spacing="8">
            <Label text="First Name" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
            <TextField fx:id="firstNameField" promptText="Enter your first name" 
                       style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14px;"/>
        </VBox>
        
        <VBox spacing="8">
            <Label text="Last Name" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
            <TextField fx:id="lastNameField" promptText="Enter your last name" 
                       style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14px;"/>
        </VBox>
        
        <VBox spacing="8">
            <Label text="Email Address" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
            <TextField fx:id="emailField" promptText="Enter your email" 
                       style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14px;"/>
        </VBox>
        
        <VBox spacing="8">
            <Label text="Password" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
            <PasswordField fx:id="passwordField" promptText="Min 8 chars: A-Z, a-z, 0-9, @#$%" 
                          style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14px;"/>
        </VBox>
        
        <VBox spacing="8">
            <Label text="Confirm Password" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" 
                          style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14px;"
                          onAction="#handleSignup"/>
        </VBox>
        
        <Button fx:id="signupButton" text="Create Account" onAction="#handleSignup" maxWidth="Infinity"
                style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 14; -fx-background-radius: 8;">
            <cursor><javafx.scene.Cursor fx:constant="HAND"/></cursor>
        </Button>
        
        <HBox alignment="CENTER" spacing="5">
            <Label text="Already have an account?" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
            <Hyperlink text="Sign In" onAction="#handleBackToLogin" style="-fx-font-size: 13px; -fx-text-fill: #667eea;"/>
        </HBox>
    </VBox>
</StackPane>
